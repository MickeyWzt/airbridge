{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd AirBridgeWeb && npm ci && npm run build",
    "watchPatterns": [
      "AirBridgeWeb/**",
      "docs/WEB_P2P.md",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "cd AirBridgeWeb && npm start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
