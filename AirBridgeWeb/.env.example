# Local development port. Production hosts usually set PORT themselves.
AIRBRIDGE_WEB_PORT=8787

# Use a stable random value in production so same-network grouping stays consistent.
# Example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AIRBRIDGE_WEB_IP_SALT=replace-with-a-random-64-character-hex-string

# Optional: point the frontend to a separate signaling server.
# Leave blank in normal production because the web app derives wss://<host>/signal.
# VITE_SIGNAL_URL=wss://your-airbridge-web.example.com/signal

# Optional: Vite dev proxy target when the Node signaling server is elsewhere.
# VITE_DEV_SIGNAL_TARGET=http://localhost:8787
